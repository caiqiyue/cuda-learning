# ============================================
#  IDE / 编辑器配置（个人环境，不上传）
# ============================================
.vscode/
.vs/
.idea/
.clangd/
*.code-workspace

# ============================================
#  构建目录（CMake / Ninja / Make 产物）
# ============================================
build/
build-*/
cmake-build-*/
out/
tmp/
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
compile_commands.json
CTestTestfile.cmake
.ninja_deps
.ninja_log
rules.ninja
*.sln
*.vcxproj
*.vcxproj.filters

# ============================================
#  编译产物（可执行文件 / 中间文件 / 库）
# ============================================
*.exe
*.o
*.obj
*.a
*.lib
*.exp
*.so
*.so.*
*.dylib
*.dll
*.pdb
*.ilk
*.idb
*.d

# ============================================
#  其它临时文件
# ============================================
__pycache__/
*.py[cod]
*.swp
*~
.DS_Store
Thumbs.db

